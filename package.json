    "vite-plugin-svgr": "^4.3.0",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      "**/*.spec.ts",
      ".git",
      "node_modules"
