    "helmet": "^8.0.0",
    "isomorphic-ws": "^5.0.0",
    "lucide-react": "^0.468.0",
    "morgan": "^1.10.0",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.3",
    "react-confetti": "^6.1.0",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.1.3",
    "tailwind-merge": "^2.6.0",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
