    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "react": "^19.2.3",
    "react-confetti": "^6.1.0",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.1.3",
    "tailwind-merge": "^2.6.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "oxlint": "^0.15.0",
    "install": "^0.13.0",
